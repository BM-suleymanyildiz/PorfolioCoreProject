@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Sayfa Bulunamadı</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #1a1a1a;
            color: #ccc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-image: linear-gradient(to bottom, #1a1a1a, #000);
        }

        .container {
            text-align: center;
            padding: 40px;
            border: 1px solid #333;
            border-radius: 10px;
            background-color: #2c2c2c;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.6);
        }

        h1 {
            font-size: 120px;
            color: #ff4c4c;
            margin: 0;
        }

        p {
            font-size: 22px;
            margin: 20px 0;
            color: #999;
        }

        a {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 24px;
            font-size: 18px;
            color: #fff;
            background-color: #444;
            border-radius: 6px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

            a:hover {
                background-color: #ff4c4c;
            }
    </style>
</head>
<body>

    <div class="container">
        <h1>404</h1>
        <p>Bu karanlıkta yolunu kaybettin...</p>
        <p><a href="/Default/Index/">Ana Sayfaya Dön</a></p>
    </div>

</body>
</html>
