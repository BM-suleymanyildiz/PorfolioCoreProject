@model Statistic
@{
    ViewData["Title"] = "CreateStatistic";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h2>Yeni İstatistik Ekleme Sayfası</h2>
<form method="post">
    <label>İstatistik Adı</label>
    <input type="text" asp-for="StatisticName" class="form-control" />
    <br />
    <label>İstatistik Değeri</label>
    <input type="text" asp-for="StatisticValue" class="form-control" />
    <br />
    <label>İstatistik İconu</label>
    <select asp-for="StatisticIcon" class="form-control" asp-items="ViewBag.IconList">
        <option value="">-- Bir ikon seçin --</option>
    </select>
    <br />
    <button class="btn btn-primary">İstatistik Ekle</button>
</form>

