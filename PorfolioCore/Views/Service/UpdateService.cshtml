@model Service

@{
    ViewData["Title"] = "UpdateService";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h1>Hizmet Güncelleme Sayfası</h1>

<form method="post">
    <input type="hidden" class="form-control" asp-for="ServiceId" />
    <label>Hizmet Sayfa açıklama</label>
    <input type="text" class="form-control" asp-for="ServiceHead" style="border:1px solid black" />
    <br /> <label>Hizmet Logo</label>
    <input type="text" class="form-control" asp-for="ServiceIcon" style="border:1px solid black" />
    <br />
    <label>Hizmet İsmi</label>
    <input type="text" class="form-control" asp-for="ServiceName" style="border:1px solid black " />
    <br />
    <label>Hizmet Açıklama</label>
    <input type="text" class="form-control" asp-for="ServiceDescription" style="border:1px solid black " />
    <br />
    <button class="btn btn-primary">Hizmet Güncelle</button>
</form>