@model Portfolio
@{
    ViewData["Title"] = "CreatePortfolio";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<h2>Yeni Portfolio Ekleme Sayfası</h2>
<form method="post">
    <label>Portfolio Başlığı</label>
    <input type="text" asp-for="Title" class="form-control" />
    <br />
    <label>Portfolio Açıklaması</label>
    <input type="text" asp-for="Description" class="form-control" />
    <br />
    <label>Portfolio Resim Yolu</label>
    <input type="text" asp-for="ImageUrl" class="form-control" />
    <br />
    <label>Kategori</label>
   
    <input type="text" asp-for="Category" class="form-control" />
    <br />
    <button type="submit" class="btn btn-primary">Portfolio Oluştur</button>
</form>

